# Free local AI is the default. No API key is required.
AI_PROVIDER=local
OLLAMA_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
# Optional deployment settings:
# PUBLIC_URL=https://your-public-host
# COOKIE_SECURE=true
# To explicitly opt into the separate paid adapter, set AI_PROVIDER=openai
# and configure OPENAI_API_KEY. Local mode never falls back to it.
