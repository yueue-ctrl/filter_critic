# Anonymous online demo: configure this only on the server / in Vercel.
# Create a key in an unbilled Google AI Studio project to use its free quota.
# Free quotas are shared by all visitors; there is no automatic paid fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Force cloud-mode locally while testing a missing/invalid key:
# DEMO_AI_PROVIDER=gemini

# Optional offline development: npm run setup:local
# Without a Gemini key, npm run dev uses installed local models when available.
OLLAMA_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
# The older account/database prototype is available with npm run dev:workspace.
# AI_PROVIDER=local
